@hostname = localhost
@port = 3000
@host = http://{{hostname}}:{{port}}

###
# POST Receta 1: Pastel de Chocolate Clásico
# Nota: Reemplaza 'ID_DE_USUARIO_EXISTENTE_1' con un ObjectId válido de un usuario en tu base de datos.
POST {{host}}/recipes
Content-Type: application/json

{
  "name": "Pastel de Chocolate Clásico",
  "steps": "Mezclar ingredientes secos, añadir húmedos, hornear a 180°C durante 30 minutos.",
  "ingredients": [
    "harina",
    "azucar",
    "huevo",
    "leche",
    "mantequilla",
    "chocolate",
    "levadura"
  ],
  "tools": [
    "batidora",
    "horno"
  ],
  "userId": "69065e6b91672c0180e101ce", 
  "category": [
    "postre",
    "panadería"
  ],
  "images": [
    "https://example.com/imagen_pastel_chocolate.jpg"
  ]
}

